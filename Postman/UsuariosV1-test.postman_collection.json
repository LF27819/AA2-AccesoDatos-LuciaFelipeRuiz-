      "name": "/api/v1/usuarios",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"status code is 201\", function () {\r",
              "    pm.expect(pm.response.code).to.eql(201);\r",
              "});\r",
              "\r",
              "const jsonResponse = pm.response.json();\r",
              "\r",
              "pm.test(\"response structure is ok\", function () {\r",
              "    pm.expect(jsonResponse).to.have.property(\"id\");\r",
              "    pm.expect(jsonResponse).to.have.property(\"nombre\");\r",
              "    pm.expect(jsonResponse).to.have.property(\"apellidos\");\r",
              "    pm.expect(jsonResponse).to.have.property(\"email\");\r",
              "    pm.expect(jsonResponse).to.have.property(\"password\");\r",
              "    pm.expect(jsonResponse).to.have.property(\"telefono\");\r",
              "    pm.expect(jsonResponse).to.have.property(\"activo\");\r",
              "    pm.expect(jsonResponse).to.have.property(\"fechaNacimiento\");\r",
              "    pm.expect(jsonResponse).to.have.property(\"eventosAsistidos\");\r",
              "    pm.expect(jsonResponse).to.have.property(\"rol\");\r",
              "    pm.expect(jsonResponse).to.have.property(\"saldoCuenta\");\r",
              "});\r",
              "\r",
              "pm.test(\"response values are ok\", function () {\r",
              "    pm.expect(jsonResponse.nombre).to.eql(pm.collectionVariables.get(\"nombre1\"));\r",
              "    pm.expect(jsonResponse.email).to.eql(pm.collectionVariables.get(\"email1\"));\r",
              "});\r",
              "\r",
              "pm.collectionVariables.set(\"usuarioId\", jsonResponse.id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
